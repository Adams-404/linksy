{
  "name": "linksy-phonenet",
  "version": "1.3.1",
  "description": "Reverse tethering CLI for Linux — share laptop Wi-Fi with your Android phone wirelessly or over USB without root",
  "main": "bin/linksy.js",
  "bin": {
    "linksy-phonenet": "./bin/linksy.js",
    "phonenet": "./bin/linksy.js",
    "phonenet-on": "./bin/phonenet-on.js",
    "phonenet-off": "./bin/phonenet-off.js",
    "phonenet-status": "./bin/phonenet-status.js",
    "phonenet-doctor": "./bin/phonenet-doctor.js",
    "linksy": "./bin/linksy.js"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node ./bin/linksy.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "tethering",
    "usb-tethering",
    "android",
    "hotspot",
    "wifi",
    "linux",
    "gnirehtet",
    "adb"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adams-404/linksy.git"
  },
  "homepage": "https://github.com/Adams-404/linksy#readme",
  "bugs": {
    "url": "https://github.com/Adams-404/linksy/issues"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "author": "Adam",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "vitest": "^3.0.7"
  }
}
